# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; this template is safe to commit (no real secrets).
# Full explanations live in ../docs/configuration.md.

# Supabase project URL — Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase anon (public) key — Project Settings -> API -> anon public.
# Public by design; row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase service_role key — Project Settings -> API -> service_role.
# SECRET: full access, bypasses all security rules. Server-only (no
# NEXT_PUBLIC_ prefix). Used by the publish route and the provisioning script.
# Never commit or paste anywhere public.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Where the guide (index.html) is deployed. Used to build the full tablet URL
# shown after publishing. Defaults to the GitHub Pages URL if left unset.
NEXT_PUBLIC_TABLET_BASE_URL=https://anthony-michael-alvrz.github.io/test/
